APP_NAME=Winston
APP_DESCRIPTION=Self-hosted personal AI assistant
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

API__HOST=0.0.0.0
API__PORT=8000

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120

DATABASE__URL=sqlite:///./winston.db

FEATURES__MEMORY_ENABLED=false
FEATURES__VOICE_ENABLED=false
FEATURES__TOOLS_ENABLED=false

# Tools are permission-denied until a trusted identity integration grants access.
# Paths are confined to these workspace roots; the default is the Winston repo.
# TOOLS__WORKSPACE_ROOTS=["/path/to/your/project"]
TOOLS__PROJECTS_CONFIG_PATH=config/projects.yaml
# Optionally discover all immediate project directories below a local root:
# TOOLS__PROJECT_ROOTS=["/path/to/your/Projects"]
TOOLS__MAX_FILE_SIZE_BYTES=1000000
TOOLS__MAX_SEARCH_RESULTS=100
TOOLS__MAX_SEARCH_FILES_SCANNED=50000
TOOLS__TERMINAL_ALLOWED_PROGRAMS=["pytest"]
TOOLS__TERMINAL_TIMEOUT_SECONDS=60
TOOLS__TERMINAL_MAX_OUTPUT_CHARS=12000
TOOLS__GIT_ALLOWED_REMOTES=[]
TOOLS__WEB_SEARCH_ENABLED=false
TOOLS__BROWSER_ALLOWED_HOSTS=[]
TOOLS__BROWSER_TIMEOUT_SECONDS=20
TOOLS__DOCKER_ALLOWED_CONTAINERS=[]
TOOLS__DOCKER_TIMEOUT_SECONDS=15
TOOLS__DOCKER_LOGS_TAIL_LINES=500
TOOLS__AGENT_MAX_STEPS=3
TOOLS__CONFIRMATION_TTL_SECONDS=300
